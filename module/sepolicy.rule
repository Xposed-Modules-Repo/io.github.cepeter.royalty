# ============================================================ #
#  SELinux policy rules for Telegram Chat Hider               #
# ============================================================ #

# Allow zygote (where MeowZygisk runs) to read module files
type telegram_chat_hider_file file_type
typeattribute telegram_chat_hider_file mlstrustedobject
allow zygote telegram_chat_hider_file file {read open getattr}
allow zygote telegram_chat_hider_file dir search

# Allow system_server to access WebUI (for APatch's root shell bridge)
allow system_server adb_data_file file *
allow system_server adb_data_file dir search

# Allow the WebUI's root shell to read/write config
allow shell telegram_chat_hider_file file *
allow shell telegram_chat_hider_file dir *

# Allow untrusted_app (Telegram) to read config at runtime
# Telegram process reads chat_hider.json via the Zygisk library
allow untrusted_app telegram_chat_hider_file file {read open getattr}
allow untrusted_app telegram_chat_hider_file dir search

# Allow file-based config updates
allow shell adb_data_file file *
