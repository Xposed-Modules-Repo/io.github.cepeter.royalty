# ============================================================ #
#  SELinux policy rules for Telegram Chat Hider               #
#  Minimal — only allow zygote to load our Zygisk module.       #
# ============================================================ #

# Module file type
type telegram_chat_hider_file file_type;

# Zygote needs to read the module libraries and config (MeowZygisk loads .so here)
allow zygote telegram_chat_hider_file dir search;
allow zygote telegram_chat_hider_file file { read open getattr };

# Shell (root) for WebUI config read/write via window.android.exec()
allow shell telegram_chat_hider_file dir { search add remove write };
allow shell telegram_chat_hider_file file { read write open getattr setattr };
